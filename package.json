{
  "name": "wealth-atlas",
  "version": "1.6.6",
  "description": "Local-first multi-currency personal finance workspace",
  "author": "Wealth Atlas",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test tests/finance-regression.test.mjs tests/migration-diagnostics.test.mjs tests/account-hierarchy.test.mjs && tsc --noEmit",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:test": "node scripts/desktop-persistence-test.mjs",
    "desktop:package": "node scripts/windows-release.mjs",
    "release:windows": "node scripts/windows-release.mjs",
    "release:publish": "set WEALTH_ATLAS_PUBLISH=1&& node scripts/windows-release.mjs",
    "release:check": "node scripts/windows-release-check.mjs",
    "release:test-installed": "node scripts/windows-installed-release-test.mjs",
    "ai:review": "node scripts/deepseek-review.mjs",
    "prepare:review": "node scripts/prepare-hermes-review.mjs",
    "read:review": "node scripts/read-hermes-review.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "dexie": "^4.0.11",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "motion": "^13.0.0",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-grid-layout": "^2.2.4",
    "recharts": "^3.1.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "zod": "^4.0.17"
  },
  "build": {
    "appId": "com.wealthatlas.desktop",
    "productName": "Wealth Atlas",
    "directories": {
      "buildResources": "build",
      "output": "desktop-dist"
    },
    "files": [
      "out/**/*",
      "desktop/**/*",
      "build/icon.svg",
      "package.json",
      "!desktop/update-token.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "artifactName": "Wealth-Atlas-Setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "xzksvpcqhz-arch",
      "repo": "wealth-atlas"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.svg",
      "legalTrademarks": "Wealth Atlas",
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
